# Copy to the root .env.local; scripts/dev_api.sh sources this as Bash.
# Generate a secret with: openssl rand -hex 32
# FRESHMESH_SECRET=replace-with-your-generated-secret
FRESHMESH_API_PORT=8100
FRESHMESH_API_HOST=127.0.0.1
FRESHMESH_DATA_DIR=data
# FRESHMESH_ENABLE_DOCS=1
# FRESHMESH_API_RELOAD=1

# Optional chat integration (provider usage may incur charges).
# ANTHROPIC_API_KEY=
# FRESHMESH_LLM_MODEL=claude-sonnet-5-5
# FRESHMESH_LLM_EFFORT=medium
FRESHMESH_CHAT_PER_IP_DAILY=20
FRESHMESH_CHAT_GLOBAL_DAILY=300

# Optional private route-geometry key; never put this in NEXT_PUBLIC_*.
# FRESHMESH_VIETMAP_ROUTE_KEY=

# Optional Jev integration via OpenRouter.
# FRESHMESH_JEV_API_KEY=
# FRESHMESH_JEV_MODEL=typesafe/jev-1.13
# FRESHMESH_JEV_GUARDRAIL=1
